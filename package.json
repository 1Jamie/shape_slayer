{
  "name": "shape-slayer",
  "version": "1.0.0",
  "description": "A skill-based 2D top-down ARPG",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node harness/index.js",
    "build:css": "sass css/ui/base.scss css/ui/base.css",
    "watch:css": "sass --watch css/ui/base.scss css/ui/base.css",
    "balance:gear": "node tests/gear-mode-balance-sim.js",
    "balance:full-run": "node tests/full-run-balance-sim.js",
    "balance:economy": "node tests/economy-balance-sim.js",
    "test:combat-scaling": "node --test tests/combat-scaling.test.js",
    "test:run-credits": "node --test tests/run-credits.test.js",
    "test:combat-economy": "node --test tests/combat-economy.test.js",
    "test:safe-room-run-save": "node --test tests/safe-room-run-save.test.js",
    "test:feature-tutorials": "node --test tests/feature-tutorials.test.js",
    "test:device-detection": "node --test tests/device-detection.test.js",
    "test:input-focus": "node --test tests/input-focus.test.js",
    "metrics:install": "npm install --prefix metrics/server && npm install --prefix metrics/gui",
    "metrics:start": "node harness/index.js --only=metrics,gui",
    "test:path-security": "node --test tests/path-security.test.js",
    "test:mp-config": "node --test tests/mp-config.test.js",
    "test:mp-combat-relay": "node --test tests/mp-combat-relay.test.js",
    "test:mp-prediction": "node --test tests/mp-prediction.test.js tests/mp-host-migration.test.js",
    "test:mp-serialize-helpers": "node --test tests/mp-serialize-helpers.test.js",
    "metrics:test": "npm test --prefix metrics/server && node --test tests/telemetry-client.test.js tests/path-security.test.js tests/mp-config.test.js tests/mp-combat-relay.test.js tests/mp-prediction.test.js tests/mp-host-migration.test.js tests/mp-serialize-helpers.test.js"
  },
  "keywords": [
    "game",
    "arpg",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.94.2"
  },
  "dependencies": {
    "pixi.js": "^8.14.3"
  }
}
